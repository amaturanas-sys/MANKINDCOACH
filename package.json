{
  "name": "mankindfactory-routine-workspace",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "Workspace clínico del coach (app local) + landing pública. MankindFactory Manager.",
  "author": "Alberto Maturana S.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --port=5247 --host=0.0.0.0",
    "dev:landing": "vite --config vite.config.landing.ts --port=5248 --host=0.0.0.0",
    "build": "tsc -b --noEmit && vite build",
    "build:admin-only": "vite build --config vite.config.admin-only.ts",
    "build:landing": "vite build --config vite.config.landing.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@dnd-kit/core": "^6.3.1",
    "lucide-react": "^0.456.0",
    "motion": "^11.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@emotion/is-prop-valid": "^1.3.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.0.0"
  }
}
